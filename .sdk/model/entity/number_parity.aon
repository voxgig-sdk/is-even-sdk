# Entity: number_parity

main: kit: entity: number_parity: {

  alias: field: {}

  fields: [
    {
      name: "ad"
      req: false
      short: "Advertisement text (present in free tier, removed in Premium and Enterprise tiers)"
      type: "`$STRING`"
    }
    {
      name: "iseven"
      req: true
      short: "True if the number is even, false if odd"
      type: "`$BOOLEAN`"
    }
  ]

  name: "number_parity"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 6
                kind: "param"
                name: "number"
                orig: "number"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/iseven/{number}/"
          parts: [
            "iseven"
            "{number}"
          ]
          select: {
            exist: [
              "number"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "iseven"
      ]
    ]
  }



}
